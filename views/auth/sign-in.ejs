<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sign In | Zoi</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <main class="auth-page">

    <section class="auth-card">

      <div class="auth-header">

        <img
          src="/images/logo.png"
          class="auth-logo"
          alt="Zoi"
        >

        <p class="auth-welcome">
          Welcome Back
        </p>

       

        <p>Sign in to continue shopping</p>

      </div>


      <form
        action="/auth/sign-in"
        method="POST"
        class="auth-form"
      >

        <div class="auth-form-group">

          <label for="username">
            Username
          </label>

          <input
            type="text"
            name="username"
            id="username"
            required
          >

        </div>


        <div class="auth-form-group">

          <label for="password">
            Password
          </label>

          <input
            type="password"
            name="password"
            id="password"
            required
          >

        </div>


        <button
          type="submit"
          class="auth-button"
        >
          Sign In
        </button>

      </form>


      <a
        href="/auth/sign-up"
        class="auth-link"
      >
        Don't have an account? Sign Up
      </a>

    </section>

  </main>

</body>
</html>