<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Shipment</title>
</head>

<body>

  <h1>Add New Shipment</h1>

  <form action="/shippments" method="POST">

    <label for="user">Customer:</label>

    <select name="user" id="user" required>
      <option value="">Select Customer</option>

      <% users.forEach(user => { %>
        <option value="<%= user._id %>">
          <%= user.username %>
        </option>
      <% }) %>

    </select>

    <br><br>


    <label for="productSearch">Products:</label>

    <input
      type="text"
      id="productSearch"
      placeholder="Search products..."
    >

    <br><br>

    <div id="productList">

      <% products.forEach(product => { %>

        <div class="product-item">

          <span>
            <%= product.name %>
          </span>

          <button
            type="button"
            onclick="addProduct('<%= product._id %>', '<%= product.name %>')"
          >
            Add
          </button>

        </div>

      <% }) %>

    </div>


    <h3>Selected Products</h3>

    <div id="selectedProducts"></div>


    <br>

    <label for="status">Status:</label>

    <select name="status" id="status">
      <option value="pending">Pending</option>
      <option value="shipped">Shipped</option>
      <option value="delivered">Delivered</option>
    </select>

    <br><br>

    <label for="shippmentAdress">Shipping Address:</label>

    <input
      type="text"
      name="shippmentAdress"
      id="shippmentAdress"
      required
    >

    <br><br>

    <label for="shippmentDate">Shipment Date:</label>

    <input
      type="date"
      name="shippmentDate"
      id="shippmentDate"
      required
    >

    <br><br>

    <button type="submit">Create Shipment</button>

  </form>

  <br>

  <a href="/shippments">Back to Shipments</a>


  <script>

    const searchInput = document.getElementById('productSearch');
    const productList = document.getElementById('productList');

    const selectedProducts = new Set();


    searchInput.addEventListener('input', () => {

      const searchValue = searchInput.value.toLowerCase();

      const products = productList.querySelectorAll('.product-item');

      products.forEach(product => {

        const name = product
          .querySelector('span')
          .textContent
          .toLowerCase();

        if (name.includes(searchValue)) {
          product.style.display = 'flex';
        } else {
          product.style.display = 'none';
        }

      });

    });


    function addProduct(id, name) {

      if (selectedProducts.has(id)) {
        return;
      }

      selectedProducts.add(id);


      const product = document.createElement('div');

      product.innerHTML = `
        <span>${name}</span>

        <button type="button" onclick="removeProduct('${id}', this)">
          Remove
        </button>

        <input
          type="hidden"
          name="products"
          value="${id}"
        >
      `;

      document
        .getElementById('selectedProducts')
        .appendChild(product);

    }


    function removeProduct(id, button) {

      selectedProducts.delete(id);

      button.parentElement.remove();

    }

  </script>

</body>
</html>