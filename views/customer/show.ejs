<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %></title>
</head>

<body>

  <h1><%= product.name %></h1>

  <p>Price: <%= product.price %></p>

  <p>Category: <%= product.category %></p>

  <hr>

  <h2>Add to Cart</h2>

  <form action="/cart/add/<%= product._id %>" method="POST">

    <label for="quantity">Quantity:</label>

    <input
      type="number"
      name="quantity"
      id="quantity"
      value="1"
      min="1"
      required
    >

    <button type="submit">
      Add to Cart
    </button>

  </form>

  <br>

  <a href="/shop">Back to Products</a>

</body>
</html>