```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Checkout | Zoi</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <%- include('../partials/_navCustomer.ejs') %>


  <!-- Checkout -->

  <main class="checkout-page">

    <h1>Checkout</h1>


    <% if (cart.length === 0) { %>

      <section class="empty-checkout">

        <h2>Your Cart is Empty</h2>

        <p>
          Add some products before checking out.
        </p>

        <a href="/shop" class="continue-shopping">
          Continue Shopping
        </a>

      </section>


    <% } else { %>


      <div class="checkout-layout">


        <!-- Order Summary -->

        <section class="checkout-products">

          <h2>Your Products</h2>

          <% cart.forEach(item => { %>

            <div class="checkout-product-card">


              <!-- Product Image -->

              <div class="checkout-product-image">

                <% if (item.category === 'tools&accessories' && item.name === 'product three') { %>

                  <img
                    src="/imges-acss/product1.png"
                    alt="<%= item.name %>"
                  >

                <% } else if (item.category === 'tools&accessories' && item.name === 'second product') { %>

                  <img
                    src="/imges-acss/product3.png"
                    alt="<%= item.name %>"
                  >

                <% } else if (item.category === 'tools&accessories' && item.name === 'product one') { %>

                  <img
                    src="/imges-acss/product2.png"
                    alt="<%= item.name %>"
                  >


                <% } else if (item.category === 'haircare' && item.name === 'product one') { %>

                  <img
                    src="/imges-acss/hair2.png"
                    alt="<%= item.name %>"
                  >

                <% } else if (item.category === 'haircare' && item.name === 'product two') { %>

                  <img
                    src="/imges-acss/hair1.png"
                    alt="<%= item.name %>"
                  >


                <% } else if (item.category === 'makeup' && item.name === 'first') { %>

                  <img
                    src="/imges-acss/makeup1.png"
                    alt="<%= item.name %>"
                  >

                <% } else if (item.category === 'makeup' && item.name === 'second') { %>

                  <img
                    src="/imges-acss/makeup2.png"
                    alt="<%= item.name %>"
                  >

                <% } else if (item.category === 'makeup' && item.name === 'third') { %>

                  <img
                    src="/imges-acss/makeup3.png"
                    alt="<%= item.name %>"
                  >

                <% } else if (item.category === 'makeup' && item.name === 'fourth') { %>

                  <img
                    src="/imges-acss/makeup4.png"
                    alt="<%= item.name %>"
                  >


                <% } else if (item.category === 'skincare' && item.name === 'fifth the eye patches') { %>

                  <img
                    src="/imges-acss/skin.png"
                    alt="<%= item.name %>"
                  >

                <% } %>

              </div>


              <div class="checkout-product-info">

                <h3>
                  <%= item.name %>
                </h3>

                <p>
                  Price:
                  <%= item.price %> BHD
                </p>

                <p>
                  Quantity:
                  <%= item.quantity %>
                </p>

                <p class="checkout-item-total">
                  <%= (item.price * item.quantity).toFixed(2) %> BHD
                </p>

              </div>

            </div>

          <% }) %>


          <div class="checkout-total">

            <span>Total</span>

            <strong>
              <%= cart.reduce((total, item) => total + (item.price * item.quantity), 0).toFixed(2) %>
              BHD
            </strong>

          </div>

        </section>


        <!-- Shipping Information -->

        <section class="checkout-form-card">

          <h2>Shipping Information</h2>

          <form action="/checkout" method="POST">


            <div class="form-group">

              <label for="shippmentAdress">
                Shipping Address
              </label>

              <input
                type="text"
                name="shippmentAdress"
                id="shippmentAdress"
                placeholder="Enter your shipping address"
                required
              >

            </div>


            <div class="form-group">

              <label for="paymentMethod">
                Payment Method
              </label>

              <select
                id="paymentMethod"
                name="paymentMethod"
                required
              >

                <option value="">
                  Select payment method
                </option>

                <option value="Apple Pay">
                  Apple Pay
                </option>

                <option value="Cash on delivery">
                  Cash on delivery
                </option>

                <option value="Paypal">
                  Paypal
                </option>

                <option value="Benefit Pay ">
                  Benefit Pay
                </option>

                <option value="Credi Card ">
                  Credit Card
                </option>

              </select>

            </div>


            <button
              type="submit"
              class="place-order-button"
            >
              Place Order
            </button>


          </form>


        </section>

      </div>

    <% } %>

  </main>

</body>
</html>
