<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Zoi | Admin Dashboard</title>

 <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <header class="dashboard-header">

    <h1>Zoi</h1>

    <p>Admin Dashboard</p>

  </header>


  <main class="dashboard">


    <!-- Visuals -->

    <div class="dashboard-visuals">


      <!-- Products Visual -->

      <section class="visual-card">

        <h2>Products by Category</h2>

        <div class="chart">


          <div class="chart-item">

            <div class="bar">

              <div
                class="bar-fill"
                style="height: <%= skincare * 30 %>px;"
              ></div>

            </div>

            <p>Skincare</p>

            <span><%= skincare %></span>

          </div>


          <div class="chart-item">

            <div class="bar">

              <div
                class="bar-fill"
                style="height: <%= makeup * 30 %>px;"
              ></div>

            </div>

            <p>Makeup</p>

            <span><%= makeup %></span>

          </div>


          <div class="chart-item">

            <div class="bar">

              <div
                class="bar-fill"
                style="height: <%= haircare * 30 %>px;"
              ></div>

            </div>

            <p>Haircare</p>

            <span><%= haircare %></span>

          </div>


          <div class="chart-item">

            <div class="bar">

              <div
                class="bar-fill"
                style="height: <%= bodycare * 30 %>px;"
              ></div>

            </div>

            <p>Bodycare</p>

            <span><%= bodycare %></span>

          </div>


          <div class="chart-item">

            <div class="bar">

              <div
                class="bar-fill"
                style="height: <%= toolsAccessories * 30 %>px;"
              ></div>

            </div>

            <p>Tools</p>

            <span><%= toolsAccessories %></span>

          </div>


        </div>

      </section>


      <!-- Shipments Visual -->

      <section class="visual-card">

        <h2>Shipment Status</h2>

        <div class="chart">


          <div class="chart-item">

            <div class="bar">

              <div
                class="bar-fill"
                style="height: <%= pendingShipments * 30 %>px;"
              ></div>

            </div>

            <p>Pending</p>

            <span><%= pendingShipments %></span>

          </div>


          <div class="chart-item">

            <div class="bar">

              <div
                class="bar-fill"
                style="height: <%= shippedShipments * 30 %>px;"
              ></div>

            </div>

            <p>Shipped</p>

            <span><%= shippedShipments %></span>

          </div>


          <div class="chart-item">

            <div class="bar">

              <div
                class="bar-fill"
                style="height: <%= deliveredShipments * 30 %>px;"
              ></div>

            </div>

            <p>Delivered</p>

            <span><%= deliveredShipments %></span>

          </div>


        </div>

      </section>


    </div>


    <!-- Total Cards -->

    <div class="dashboard-cards">


      <!-- Products Total -->

      <section class="dashboard-card">

        <div class="card-content">

          <h2>Products</h2>

          <p class="card-number">
            <%= products %>
          </p>

          <p>Total Products</p>

          <a href="/products" class="dashboard-button">
            Products
          </a>

        </div>

      </section>


      <!-- Shipments Total -->

      <section class="dashboard-card">

        <div class="card-content">

          <h2>Shipments</h2>

          <p class="card-number">
            <%= shipments %>
          </p>

          <p>Total Shipments</p>

          <a href="/shippments" class="dashboard-button">
            Shipments
          </a>

        </div>

      </section>


    </div>


  </main>

</body>
</html>