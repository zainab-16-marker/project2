<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Shipments</title>
</head>

<body>

  <h1>My Shipments</h1>

  <% if (shippments.length === 0) { %>

    <p>You don't have any shipments yet.</p>

  <% } else { %>

    <% shippments.forEach(shippment => { %>

      <div>

        <h2>Shipment</h2>

        <p>
          <strong>Status:</strong>
          <%= shippment.status %>
        </p>

        <p>
          <strong>Shipping Address:</strong>
          <%= shippment.shippmentAdress %>
        </p>

        <p>
          <strong>Shipment Date:</strong>
          <%= shippment.shippmentDate.toDateString() %>
        </p>
        <p>
          <strong>Payment Method:</strong>
          <%= shippment.paymentMethod %>
        </p>


        <h3>Products</h3>

        <% shippment.products.forEach(product => { %>

          <p>
            <%= product.name %> -
            <%= product.price %>
          </p>

        <% }) %>

      </div>

      <hr>

    <% }) %>

  <% } %>

  <br>

  <a href="/shop">Continue Shopping</a>

</body>
</html>