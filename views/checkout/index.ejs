<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Checkout | Zoi</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- Navbar -->

  <nav class="navbar">

    <a href="/shop" class="navbar-logo">
      ZOI
    </a>

    <div class="navbar-actions">

      <a href="/cart" class="cart-link" aria-label="Cart">
        🛒
      </a>

      <button
        class="menu-button"
        onclick="toggleMenu()"
        aria-label="Menu"
      >
        ☰
      </button>

    </div>

    <div class="dropdown-menu" id="dropdownMenu">

      <a href="/my-shipments">
        Shipments
      </a>

      <a href="/auth/sign-out">
        Sign Out
      </a>

    </div>

  </nav>


  <!-- Checkout -->

  <main class="checkout-page">

    <h1>Checkout</h1>


    <% if (cart.length === 0) { %>

      <section class="empty-checkout">

        <h2>Your Cart is Empty</h2>

        <p>
          Add some products before checking out.
        </p>

        <a href="/shop" class="continue-shopping">
          Continue Shopping
        </a>

      </section>


    <% } else { %>


      <div class="checkout-layout">


        <!-- Order Summary -->

        <section class="checkout-products">

          <h2>Your Products</h2>

          <% cart.forEach(item => { %>

            <div class="checkout-product-card">

              <div class="checkout-product-image">
                <p>Product Image</p>
              </div>

              <div class="checkout-product-info">

                <h3>
                  <%= item.name %>
                </h3>

                <p>
                  Price:
                  <%= item.price %> BHD
                </p>

                <p>
                  Quantity:
                  <%= item.quantity %>
                </p>

                <p class="checkout-item-total">
                  <%= (item.price * item.quantity).toFixed(2) %> BHD
                </p>

              </div>

            </div>

          <% }) %>


          <div class="checkout-total">

            <span>Total</span>

            <strong>
              <%= cart.reduce((total, item) => total + (item.price * item.quantity), 0).toFixed(2) %>
              BHD
            </strong>

          </div>

        </section>


        <!-- Shipping Information -->

        <section class="checkout-form-card">

          <h2>Shipping Information</h2>

          <form action="/checkout" method="POST">


            <div class="form-group">

              <label for="shippmentAdress">
                Shipping Address
              </label>

              <input
                type="text"
                name="shippmentAdress"
                id="shippmentAdress"
                placeholder="Enter your shipping address"
                required
              >

            </div>


            <div class="form-group">

              <label for="paymentMethod">
                Payment Method
              </label>

              <select
                id="paymentMethod"
                name="paymentMethod"
                required
              >

                <option value="">
                  Select payment method
                </option>

                <option value="Apple Pay">
                  Apple Pay
                </option>

                <option value="Cash on delivery">
                  Cash on delivery
                </option>

                <option value="Paypal">
                  Paypal
                </option>

                <option value="Benefit Pay ">
                  Benefit Pay
                </option>

                <option value="Credi Card ">
                  Credit Card
                </option>

              </select>

            </div>


            <button
              type="submit"
              class="place-order-button"
            >
              Place Order
            </button>


          </form>


          
        </section>

      </div>

    <% } %>

  </main>


  <!-- Navbar Menu Script -->

  <script>

    function toggleMenu() {

      const menu = document.getElementById('dropdownMenu');

      menu.classList.toggle('show');

    }

  </script>

</body>
</html>