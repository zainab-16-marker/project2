```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Products | Zoi</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <!-- Admin Navbar -->

  <nav class="admin-navbar">

    <a href="/admin/dashboard" class="admin-logo">
      ZOI
    </a>

    <div class="admin-nav-links">

      <a href="/admin/dashboard">
        Dashboard
      </a>

      <a href="/products">
        Products
      </a>

      <a href="/shippments">
        Shipments
      </a>

      <a href="/auth/sign-out">
        Sign Out
      </a>

    </div>

  </nav>


  <main class="admin-page">


    <!-- Page Header -->

    <div class="admin-page-header">

      <div>

        <h1>Products</h1>

        <p>
          Manage all beauty products
        </p>

      </div>

    </div>


    <!-- Add Product -->

    <div class="add-product-container">

      <a
        href="/products/new"
        class="admin-button"
      >
        + Add New Product
      </a>

    </div>


    <!-- Products -->

    <% if (products.length === 0) { %>

      <div class="empty-card">

        <p>
          No products found.
        </p>

      </div>

    <% } else { %>

      <div class="products-grid">

        <% products.forEach((product, index) => { %>

          <div class="admin-product-card">


            <!-- Product Image -->

            <div class="product-image">

              <!-- Tools & Accessories -->

              <% if (product.category === 'tools&accessories' && product.name === 'product three') { %>

                <img
                  src="/imges-acss/product1.png"
                  alt="<%= product.name %>"
                >

              <% } else if (product.category === 'tools&accessories' && product.name === 'second product') { %>

                <img
                  src="/imges-acss/product3.png"
                  alt="<%= product.name %>"
                >

              <% } else if (product.category === 'tools&accessories' && product.name === 'product one') { %>

                <img
                  src="/imges-acss/product2.png"
                  alt="<%= product.name %>"
                >


              <!-- Haircare -->

              <% } else if (product.category === 'haircare' && product.name === 'product one') { %>

                <img
                  src="/imges-acss/hair2.png"
                  alt="<%= product.name %>"
                >

              <% } else if (product.category === 'haircare' && product.name === 'product two') { %>

                <img
                  src="/imges-acss/hair1.png"
                  alt="<%= product.name %>"
                >


              <!-- Makeup -->

              <% } else if (product.category === 'makeup' && product.name === 'first') { %>

                <img
                  src="/imges-acss/makeup1.png"
                  alt="<%= product.name %>"
                >

              <% } else if (product.category === 'makeup' && product.name === 'second') { %>

                <img
                  src="/imges-acss/makeup2.png"
                  alt="<%= product.name %>"
                >

              <% } else if (product.category === 'makeup' && product.name === 'third') { %>

                <img
                  src="/imges-acss/makeup3.png"
                  alt="<%= product.name %>"
                >

              <% } else if (product.category === 'makeup' && product.name === 'fourth') { %>

                <img
                  src="/imges-acss/makeup4.png"
                  alt="<%= product.name %>"
                >


              <!-- Skin -->

              <% } else if (product.category === 'skincare' && product.name === 'fifth the eye patches') { %>

                <img
                  src="/imges-acss/skin.png"
                  alt="<%= product.name %>"
                >

              <% } %>

            </div>


            <!-- Product Information -->

            <div class="product-card-header">

              <h2>
                <%= product.name %>
              </h2>

              <span class="product-category">
                <%= product.category %>
              </span>

            </div>


            <div class="admin-product-info">

              <p>
                <strong>Price:</strong>
                <%= product.price %> BHD
              </p>

              <p>
                <strong>Quantity:</strong>
                <%= product.quantity %>
              </p>

            </div>


            <!-- View -->

            <a
              href="/products/<%= product._id %>"
              class="view-product-button"
            >
              View Product
            </a>


          </div>

        <% }) %>

      </div>

    <% } %>


  </main>

</body>
</html>
